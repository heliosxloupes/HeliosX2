# ───────────────────────────────────────────────────────────────────────────────
# HeliosX environment variables
#
# This file lists every environment variable the app reads at runtime.
# Copy to `.env.local` (gitignored) and fill in real values for local dev.
#
# IMPORTANT — DO NOT COMMIT THE FILLED-IN VERSION. .env.local is in .gitignore;
# keep it that way. Real secrets should travel via 1Password / encrypted vault
# or be pulled per-environment from Vercel:
#
#   vercel env pull .env.development.local   # dev values
#   vercel env pull .env.production.local    # prod values
#
# Variables prefixed NEXT_PUBLIC_ ship in the client bundle. Treat the
# unprefixed ones as production secrets — they never enter client code and
# should never be shared in Slack, email, or chat without encryption.
# ───────────────────────────────────────────────────────────────────────────────


# ───────────────────────────────────────────────────────────────────────────────
# Stripe — payments, checkout, webhook
# Dashboard: https://dashboard.stripe.com/apikeys
# ───────────────────────────────────────────────────────────────────────────────

# PUBLIC. Used in checkout/page.tsx. Begins with pk_test_ in test mode, pk_live_ in prod.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# SECRET. Used by every server-side Stripe call (checkout session, webhook,
# session-status, order confirmation backfill, the sync-stripe-catalogue
# script). Begins with sk_test_ in test mode, sk_live_ in prod.
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# SECRET. Used in app/api/stripe/webhook for signature verification.
# Find this at https://dashboard.stripe.com/webhooks → your endpoint → "Signing secret".
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# PUBLIC. Optional Stripe Price IDs for upsells at checkout. Used in checkout/page.tsx.
NEXT_PUBLIC_STRIPE_PRICE_PRESCRIPTION=price_prescription_here
NEXT_PUBLIC_STRIPE_PRICE_WARRANTY=price_warranty_here


# ───────────────────────────────────────────────────────────────────────────────
# Supabase — database, auth, storage
# Dashboard: https://supabase.com/dashboard/project/<project>/settings/api
# ───────────────────────────────────────────────────────────────────────────────

# PUBLIC. The project URL. Used by both client and server Supabase clients.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# PUBLIC. The anon (public) API key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# SECRET. Server-side only. Bypasses Row Level Security. Used in
# lib/supabase/server.ts and lib/static-admin-auth.ts. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here


# ───────────────────────────────────────────────────────────────────────────────
# Resend — transactional email (order confirmations, drips)
# Dashboard: https://resend.com/api-keys
# ───────────────────────────────────────────────────────────────────────────────

# SECRET. Used in lib/email.ts for every transactional send.
RESEND_API_KEY=re_your_resend_key_here

# CONFIG. The verified from-address. Must match a domain verified in your Resend dashboard.
RESEND_FROM_EMAIL=HeliosX <orders@heliosxloupes.com>


# ───────────────────────────────────────────────────────────────────────────────
# Admin authentication
# ───────────────────────────────────────────────────────────────────────────────

# CONFIG. Comma-separated list of email addresses allowed admin access.
# Used by lib/admin-emails.ts. Sample default:
ADMIN_SEED_EMAILS=heliosxloupes@gmail.com,kylelieberbaum@gmail.com

# SECRET. Password for the static admin login route (/admin/login).
# Used in app/api/admin/static-login/route.ts. Make this long and random.
ADMIN_STATIC_PASSWORD=change_me_long_random_password

# SECRET. Signs the static-admin session cookie. Used in lib/static-admin-auth.ts.
# Any high-entropy string (32+ chars). Generate with `openssl rand -base64 32`.
ADMIN_STATIC_SESSION_SECRET=change_me_base64_random_string


# ───────────────────────────────────────────────────────────────────────────────
# Vercel — hosting, cron protection, build environment
# Vercel itself does not need an API key inside the running app. The values
# below are how Vercel-managed features (cron, deploys) communicate with our
# code.
# ───────────────────────────────────────────────────────────────────────────────

# SECRET. Sent by Vercel Cron with the Authorization header, verified by
# app/api/cron/process-email-drips/route.ts to prevent unauthenticated triggers.
CRON_SECRET=change_me_random_value

# PUBLIC. The canonical site origin (no trailing slash). Used in checkout
# returns, cron emails, and order confirmation links. In Vercel deploys,
# this is typically set to https://heliosxvision.com. Locally:
# http://localhost:3000.
NEXT_PUBLIC_BASE_URL=http://localhost:3000


# ───────────────────────────────────────────────────────────────────────────────
# Google — analytics + Search Console verification
# Both are optional but required to capture GSC / GA4 data.
# ───────────────────────────────────────────────────────────────────────────────

# PUBLIC. GA4 measurement ID (G-XXXXXXX). Used by components/AnalyticsScripts.tsx.
# Get it from https://analytics.google.com/ → Admin → Data Streams.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# PUBLIC. Google Search Console meta-tag verification token. Used in lib/seo.ts.
# Required only if verifying domain via the HTML meta-tag method (not DNS).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=


# ───────────────────────────────────────────────────────────────────────────────
# Runtime / platform — set automatically, do not override unless you have a reason
# ───────────────────────────────────────────────────────────────────────────────

# Next.js / Node sets this automatically.
# NODE_ENV=development | production

# Used by server.js (custom server). Vercel ignores these; Node servers use them.
# HOSTNAME=0.0.0.0
# PORT=3000
