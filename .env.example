# Stripe publishable key for client-side usage (e.g., embedded checkout)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Stripe secret key for server-side Checkout session creation
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Optional add-on price IDs used during checkout
NEXT_PUBLIC_STRIPE_PRICE_PRESCRIPTION=price_prescription_here
NEXT_PUBLIC_STRIPE_PRICE_WARRANTY=price_warranty_here

# Stripe webhook secret for /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
ADMIN_SEED_EMAILS=heliosxloupes@gmail.com,kylelieberbaum@gmail.com

# Resend
RESEND_API_KEY=re_your_resend_key_here
RESEND_FROM_EMAIL=HeliosX <orders@heliosxloupes.com>

# Vercel Cron protection
CRON_SECRET=change_me
